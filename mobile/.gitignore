# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios

# /android is regenerated by `expo prebuild` and mostly ignored — EXCEPT the
# hand-written Kotlin native layer (spec 006/007), which has no other home
# and was lost once already when prebuild wiped this folder outright
# (specs/007-android-native-recovery/spec.md FR-008). The block below keeps
# that subtree tracked so a future prebuild can only ever regenerate
# boilerplate around it, never delete the only copy of it again.
/android/*
!/android/app
/android/app/*
!/android/app/src
!/android/app/build.gradle
/android/app/src/*
!/android/app/src/main
!/android/app/src/test
!/android/app/src/androidTest
/android/app/src/main/*
!/android/app/src/main/java
!/android/app/src/main/AndroidManifest.xml
/android/app/src/main/java/*
!/android/app/src/main/java/com
/android/app/src/main/java/com/*
!/android/app/src/main/java/com/oplforge
