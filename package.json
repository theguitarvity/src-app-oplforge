{
  "name": "opl-forge",
  "version": "0.1.0",
  "description": "Prepare, organize e gerencie seu HD do PS2 com facilidade.",
  "author": {
    "name": "OPL Forge",
    "email": "victorllsilv.dev@gmail.com"
  },
  "desktopName": "com.oplforge.app",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=9"
  },
  "scripts": {
    "preinstall": "node scripts/check-node-version.js",
    "dev": "vite",
    "electron:dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsup electron/main.ts electron/preload.ts --format cjs --out-dir dist-electron --external electron --external webtorrent --watch\" \"wait-on tcp:5173 dist-electron/main.cjs dist-electron/preload.cjs && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "electron:dev:linux": "concurrently -k \"vite --host 127.0.0.1\" \"tsup electron/main.ts electron/preload.ts --format cjs --out-dir dist-electron --external electron --external webtorrent --watch\" \"wait-on tcp:5173 dist-electron/main.cjs dist-electron/preload.cjs && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron --no-sandbox --ozone-platform=x11 --disable-gpu .\"",
    "build": "tsc --noEmit && vite build && tsup electron/main.ts electron/preload.ts --format cjs --out-dir dist-electron --external electron --external webtorrent",
    "test": "vitest --pool=threads",
    "test:run": "vitest run --pool=threads",
    "test:unit": "vitest run tests/unit --pool=threads",
    "test:contract": "vitest run tests/contract --pool=threads",
    "test:integration": "vitest run tests/integration --pool=threads",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky",
    "electron:build": "pnpm build && electron-builder",
    "electron:install:local": "bash scripts/install-local.sh"
  },
  "dependencies": {
    "@hookform/resolvers": "latest",
    "@radix-ui/react-dialog": "latest",
    "@radix-ui/react-label": "latest",
    "@radix-ui/react-progress": "latest",
    "@radix-ui/react-select": "latest",
    "@radix-ui/react-separator": "latest",
    "@radix-ui/react-slot": "latest",
    "@tanstack/react-query": "latest",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "electron-updater": "^6.8.9",
    "ftp-srv": "^4.6.3",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-hook-form": "latest",
    "react-router-dom": "latest",
    "tailwind-merge": "latest",
    "webtorrent": "^3.0.16",
    "yauzl": "3.4.0",
    "zod": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@commitlint/cli": "latest",
    "@commitlint/config-conventional": "latest",
    "@eslint/js": "latest",
    "@tailwindcss/postcss": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "latest",
    "autoprefixer": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "42.4.1",
    "electron-builder": "latest",
    "eslint": "latest",
    "eslint-config-prettier": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "husky": "latest",
    "jsdom": "latest",
    "lint-staged": "latest",
    "postcss": "latest",
    "prettier": "latest",
    "tailwindcss": "latest",
    "tsup": "latest",
    "tsx": "latest",
    "typescript": "6.0.3",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wait-on": "latest"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
